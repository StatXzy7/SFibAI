__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
