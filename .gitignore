# Ignore generated training and evaluation outputs
artifacts/runs/
artifacts/eval_results/
artifacts/feature_cache/
artifacts/figures/heatmaps/
artifacts/figures/tsne/

# Ignore local checkpoints by default, but keep the directory and docs
checkpoints/*
!checkpoints/README.md

# Keep checked-in public sample assets
!artifacts/sample_results/
!artifacts/sample_results/**
!data/seg_samples_500/
!data/seg_samples_500/**

# Python cache and build files
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local-only working directories not part of the public repository.
# Leading slash anchors each rule to the repo root so the tracked
# siblings (data/, scripts/figure_generation/, scripts/run/, artifacts/)
# are never matched.
/dataset/
/results/
/scripts/figure_generate/
/scripts/train_eval/

# Local release/reporting notes
/ARCHIVE_MANIFEST.md
/SOFTWARE_VERSIONS.md
/VERSION
